	note = {ADS Bibcode: 1990ApJ...358..189D},
	keywords = {Astrophysics, Binary Stars, Main Sequence Stars, Mass Ratios, Monte Carlo Method, NEBULAE: PLANETARY, Planetary Nebulae, STARS: BINARIES, STARS: EVOLUTION, Statistical Analysis, Stellar Envelopes, Stellar Evolution, Stellar Mass, White Dwarf Stars},
	pages = {189},
}

@article{de_kool_common_1990-1,
	title = {Common envelope evolution and double cores of planetary nebulae},
	volume = {358},
	issn = {0004-637X, 1538-4357},
	url = {http://adsabs.harvard.edu/doi/10.1086/168974},
	doi = {10.1086/168974},
	abstract = {I perform a statistical study of the rate at which close binaries consisting of a white dwarf and a mainsequence companion are formed by common envelope evolution. Using a Monte Carlo technique, a population of zero-age binaries is constructed, with likely distributions over primary mass, separation, and mass ratio. The evolution of these systems is followed using simple analytic fits to more detailed evolutionary calculations. If a binary undergoes a common envelope phase during its evolution, the outcome is predicted with the help of the standard assumption that a fraction a of the gravitational binding energy between the secondary and the giant core is available to eject the envelope.},
	language = {en},
	urldate = {2023-02-03},
	journal = {\apj},
	author = {\DE{Kool}{de}{de} Kool, M.},
	month = jul,
	year = {1990},
