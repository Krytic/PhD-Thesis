@article{willcox_constraints_2021,
	title = {Constraints on {Weak} {Supernova} {Kicks} from {Observed} {Pulsar} {Velocities}},
	volume = {920},
	issn = {0004-637X},
	url = {https://ui.adsabs.harvard.edu/abs/2021ApJ...920L..37W},
	doi = {10.3847/2041-8213/ac2cc8},
	abstract = {Observations of binary pulsars and pulsars in globular clusters suggest that at least some pulsars must receive weak natal kicks at birth. If all pulsars received strong natal kicks above 50 km s-1, those born in globular clusters would predominantly escape, while wide binaries would be disrupted. On the other hand, observations of transverse velocities of isolated radio pulsars indicate that only 5 ± 2\% have velocities below 50 km s-1. We explore this apparent tension with rapid binary population synthesis modeling. We propose a model in which supernovae with characteristically low natal kicks (e.g., electron-capture supernovae) only occur if the progenitor star has been stripped via binary interaction with a companion. We show that this model naturally reproduces the observed pulsar speed distribution and without reducing the predicted merging double neutron star yield. We estimate that the zero-age main-sequence mass range for noninteracting progenitors of electron-capture supernovae should be no wider than ≈0.2 M⊙.},
	urldate = {2023-09-08},
	journal = {\apj},
	author = {Willcox, Reinhold and Mandel, Ilya and Thrane, Eric and Deller, Adam and Stevenson, Simon and Vigna-Gómez, Alejandro},
	month = oct,
	year = {2021},
	note = {ADS Bibcode: 2021ApJ...920L..37W},
	keywords = {1108, 1306, 153, 1668, Astrophysics - High Energy Astrophysical Phenomena, Astrophysics - Solar and Stellar Astrophysics, Binary pulsars, Neutron stars, Pulsars, Supernovae},
	pages = {L37},
	file = {Full Text PDF:/home/sric560/Zotero/storage/UUPMMV4X/Willcox et al. - 2021 - Constraints on Weak Supernova Kicks from Observed .pdf:application/pdf},
}

