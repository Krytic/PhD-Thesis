	pages = {3975--3991},
	file = {Full Text PDF:/home/sric560/Zotero/storage/9RNRDBVT/Petrosky et al. - 2021 - Variability, periodicity, and contact binaries in WISE.pdf:application/pdf;Snapshot:/home/sric560/Zotero/storage/PV4TAMC3/6207953.html:text/html},
}

