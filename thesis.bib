@article{eggleton_structure_1967,
	title = {The structure of narrow shells in red giants},
	volume = {135},
	issn = {0035-8711},
	url = {https://ui.adsabs.harvard.edu/abs/1967MNRAS.135..243E},
	doi = {10.1093/mnras/135.3.243},
	abstract = {Stars of moderate mass (1-2 M0) which have reached the red giant stage contain a helium core surrounded by a thin hydrogen burning shell, beyond which there is a region in radiative equilibrium. A method is given for computing in some detail the structure of the shell source, largely independently of the rest of the star, and the results of this method are compared with the zero-order approximation (Schwarzschild 1958) in which the shell source is treated as a jump discontinuity in composition and luminosity. A similar method is given for obtaining the energy released by gravitational contraction in the narrow shell of non-degenerate helium immediately below the hydrogen burning shell.},
	urldate = {2023-10-21},
	journal = {\mnras},
