@article{bouffanais_new_2021,
	title = {New insights on binary black hole formation channels after {GWTC}-2: young star clusters versus isolated binaries},
	volume = {507},
	issn = {0035-8711},
	shorttitle = {New insights on binary black hole formation channels after {GWTC}-2},
	url = {https://ui.adsabs.harvard.edu/abs/2021MNRAS.507.5224B},
	doi = {10.1093/mnras/stab2438},
	abstract = {With the recent release of the Second Gravitational Wave Transient Catalog (GWTC-2), which introduced dozens of new detections, we are at a turning point of gravitational wave astronomy, as we are now able to directly infer constraints on the astrophysical population of compact objects. Here, we tackle the burning issue of understanding the origin of binary black hole (BBH) mergers. To this effect, we make use of state-of-the-art population synthesis and N-body simulations, to represent two distinct formation channels: BBHs formed in the field (isolated channel) and in young star clusters (dynamical channel). We then use a Bayesian hierarchical approach to infer the distribution of the mixing fraction f, with f = 0 (f = 1) in the pure dynamical (isolated) channel. We explore the effects of additional hyperparameters of the model, such as the spread in metallicity σZ and the parameter σsp, describing the distribution of spin magnitudes. We find that the dynamical model is slightly favoured with a median value of f = 0.26, when σsp = 0.1 and σZ = 0.4. Models with higher spin magnitudes tend to strongly favour dynamically formed BBHs (f ≤ 0.1 if σsp = 0.3). Furthermore, we show that hyperparameters controlling the rates of the model, such as σZ, have a large impact on the inference of the mixing fraction, which rises from 0.18 to 0.43 when we increase σZ from 0.2 to 0.6, for a fixed value of σsp = 0.1. Finally, our current set of observations is better described by a combination of both formation channels, as a pure dynamical scenario is excluded at the \$99\{\{{\textbackslash} {\textbackslash}rm per{\textbackslash} cent\}\}\$ credible interval, except when the spin magnitude is high.},
	urldate = {2024-04-29},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Bouffanais, Yann and Mapelli, Michela and Santoliquido, Filippo and Giacobbo, Nicola and Di Carlo, Ugo N. and Rastello, Sara and Artale, M. Celeste and Iorio, Giuliano},
	month = nov,
	year = {2021},
	note = {Publisher: OUP
ADS Bibcode: 2021MNRAS.507.5224B},
	keywords = {Astrophysics - High Energy Astrophysical Phenomena, black hole physics, gravitational waves, methods: numerical, methods: statistical},
	pages = {5224--5235},
}

@article{broekgaarden_impact_2021,
	title = {Impact of massive binary star and cosmic evolution on gravitational wave observations {I}: black hole-neutron star mergers},
	volume = {508},
	issn = {0035-8711},
	shorttitle = {Impact of massive binary star and cosmic evolution on gravitational wave observations {I}},
	url = {https://ui.adsabs.harvard.edu/abs/2021MNRAS.508.5028B},
	doi = {10.1093/mnras/stab2716},
	abstract = {Mergers of black hole-neutron star (BHNS) binaries have now been observed by gravitational wave (GW) detectors with the recent announcement of GW200105 and GW200115. Such observations not only provide confirmation that these systems exist but will also give unique insights into the death of massive stars, the evolution of binary systems and their possible association with gamma-ray bursts, r-process enrichment, and kilonovae. Here, we perform binary population synthesis of isolated BHNS systems in order to present their merger rate and characteristics for ground-based GW observatories. We present the results for 420 different model permutations that explore key uncertainties in our assumptions about massive binary star evolution (e.g. mass transfer, common-envelope evolution, supernovae), and the metallicity-specific star formation rate density, and characterize their relative impacts on our predictions. We find intrinsic local BHNS merger rates spanning \${\textbackslash}mathcal \{R\}\_\{{\textbackslash}rm \{m\}\}{\textasciicircum}0 {\textbackslash}approx\$ 4-830 \${\textbackslash}, {\textbackslash}rm \{Gpc\}{\textasciicircum}\{-3\}\$\${\textbackslash}, {\textbackslash}rm \{yr\}{\textasciicircum}\{-1\}\$ for our full range of assumptions. This encompasses the rate inferred from recent BHNS GW detections and would yield detection rates of \${\textbackslash}mathcal \{R\}\_\{{\textbackslash}rm \{det\}\} {\textbackslash}approx 1\$-180\${\textbackslash}, {\textbackslash}rm \{yr\}{\textasciicircum}\{-1\}\$ for a GW network consisting of LIGO, Virgo, and KAGRA at design sensitivity. We find that the binary evolution and metallicity-specific star formation rate density each impacts the predicted merger rates by order \${\textbackslash}mathcal \{O\}(10)\$. We also present predictions for the GW-detected BHNS merger properties and find that all 420 model variations predict that \${\textbackslash}lesssim 5\{\{{\textbackslash} {\textbackslash}rm per{\textbackslash} cent\}\}\$ of the BHNS mergers have BH masses \$m\_\{{\textbackslash}rm \{BH\}\} rsim 18{\textbackslash}, {\textbackslash}rm \{M\}\_\{{\textbackslash}odot \}\$, total masses \$m\_\{{\textbackslash}rm \{tot\}\} rsim 20{\textbackslash}, {\textbackslash}rm \{M\}\_\{{\textbackslash}odot \}\$, chirp masses \$\{{\textbackslash}mathcal \{M\}\}\_\{{\textbackslash}rm \{c\}\} rsim 5.5{\textbackslash}, {\textbackslash}rm \{M\}\_\{{\textbackslash}odot \}\$, and mass ratios qf ≳ 12 or qf ≲ 2. Moreover, we find that massive NSs with \$m\_\{{\textbackslash}rm \{NS\}\} 2{\textbackslash}, {\textbackslash}rm \{M\}\_\{{\textbackslash}odot \}\$ are expected to be commonly detected in BHNS mergers in almost all our model variations. Finally, a wide range of \${\textbackslash}sim 0\{\{{\textbackslash} {\textbackslash}rm per{\textbackslash} cent\}\}\$ to \$70\{\{{\textbackslash} {\textbackslash}rm per{\textbackslash} cent\}\}\$ of the BHNS mergers are predicted to eject mass during the merger. Our results highlight the importance of considering variations in binary evolution and cosmological models when predicting, and eventually evaluating, populations of BHNS mergers.},
	urldate = {2024-04-29},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Broekgaarden, Floor S. and Berger, Edo and Neijssel, Coenraad J. and Vigna-Gómez, Alejandro and Chattopadhyay, Debatri and Stevenson, Simon and Chruslinska, Martyna and Justham, Stephen and de Mink, Selma E. and Mandel, Ilya},
	month = dec,
	year = {2021},
	note = {Publisher: OUP
ADS Bibcode: 2021MNRAS.508.5028B},
	keywords = {(transients:) black hole-neutron star mergers, Astrophysics - High Energy Astrophysical Phenomena, gravitational waves, stars: evolution},
	pages = {5028--5063},
}

@article{igoshev_combined_2021,
	title = {Combined analysis of neutron star natal kicks using proper motions and parallax measurements for radio pulsars and {Be} {X}-ray binaries},
	volume = {508},
	issn = {0035-8711},
	url = {https://ui.adsabs.harvard.edu/abs/2021MNRAS.508.3345I},
	doi = {10.1093/mnras/stab2734},
	abstract = {Supernova explosion and the associated neutron star (NS) natal kicks are important events on a pathway of a binary to become a gravitational wave source, an X-ray binary, or a millisecond radio pulsar. Weak natal kicks often lead to binary survival, while strong kicks frequently disrupt the binary. In this article, we aim to further constrain NS natal kicks in binaries. We explore binary population synthesis models by varying prescription for natal kick, remnant mass, and mass accretion efficiency. We introduce a robust statistical technique to analyse combined observations of different nature. Using this technique, we further test different models using parallax and proper motion measurements for young isolated radio pulsars and similar measurements for Galactic Be X-ray binaries (BeXs). Our best model for natal kicks is consistent with both measurements and contains a fraction of w = 0.2 ± 0.1 weak natal kicks with \${\textbackslash}sigma \_1 = 45{\textasciicircum}\{+25\}\_\{-15\}\$ km s-1, the remaining natal kicks are drawn from the high-velocity component, same as in previous works: σ2 = 336 km s-1. We found that currently used models for natal kicks of NSs produced by electron capture supernova (ecSN; combination of Maxwellian σ = 265 km s-1 and σ = 30 km s-1 for electron capture) are inconsistent or marginally consistent with parallaxes and proper motions measured for isolated radio pulsars. We suggest a new model for natal kicks of ecSN, which satisfy both observations of isolated radio pulsars and BeXs.},
	urldate = {2024-04-29},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Igoshev, Andrei P. and Chruslinska, Martyna and Dorozsmai, Andris and Toonen, Silvia},
	month = dec,
	year = {2021},
	note = {Publisher: OUP
ADS Bibcode: 2021MNRAS.508.3345I},
	keywords = {Astrophysics - High Energy Astrophysical Phenomena, Astrophysics - Solar and Stellar Astrophysics, binaries: general, methods: statistical, pulsars: general, stars: massive, stars: neutron, X-rays: binaries},
	pages = {3345--3364},
}

@article{fragione_black-hole-neutron-star_2021,
	title = {Black-hole-{Neutron}-star {Mergers} {Are} {Unlikely} {Multimessenger} {Sources}},
	volume = {923},
	issn = {0004-637X},
	url = {https://ui.adsabs.harvard.edu/abs/2021ApJ...923L...2F},
	doi = {10.3847/2041-8213/ac3bcd},
	abstract = {The promise by the LIGO/Virgo/Kagra (LVK) collaboration to detect black-hole-neutron-star (BH-NS) mergers via gravitational wave (GW) emission has recently been fulfilled with the detection of GW200105 and GW200115. Mergers of BH-NS binaries are particularly exciting for their multimessenger potential since GW detection can be followed by an electromagnetic (EM) counterpart (kilonova, gamma-ray burst, afterglow) that can reveal important information on the equation of state (EOS) of NSs and the nature of the BH spin. This can happen whenever the NS does not directly plunge into the BH, but rather is tidally disrupted, leaving behind debris to accrete. We carry out a statistical study of the binary stars that evolve to form a BH-NS binary and compute the rate of merger events that can be followed by an EM counterpart. We find that ≳50\% of the mergers can lead to an EM counterpart only in the case where BHs are born highly spinning (χ BH ≳ 0.7), while this fraction does not exceed about 30\% for stiff NS EOSs and a few percent for soft NS EOSs for low-spinning BHs (χ BH ≲ 0.2), suggesting that a high rate of EM counterparts of BH-NS would provide support for high natal BH spins. However, the possibilities that BHs are born with near-maximal spins and that NS internal structure is described by a stiff EOS are disfavored by current LVK constraints. Considering that these values only represent an upper limit to observe an EM counterpart due to current observational limitations, such as brightness sensitivity and sky localization, BH-NS mergers are unlikely multimessenger sources.},
	urldate = {2024-04-29},
	journal = {The Astrophysical Journal},
	author = {Fragione, Giacomo},
	month = dec,
	year = {2021},
	note = {Publisher: IOP
ADS Bibcode: 2021ApJ...923L...2F},
	keywords = {1108, 1611, 162, 675, 676, 677, 678, 886, 98, Astrophysics - Astrophysics of Galaxies, Astrophysics - High Energy Astrophysical Phenomena, General Relativity and Quantum Cosmology},
	pages = {L2},
	file = {Full Text PDF:/home/sric560/Zotero/storage/L8JQUSBM/Fragione - 2021 - Black-hole-Neutron-star Mergers Are Unlikely Multi.pdf:application/pdf},
}

