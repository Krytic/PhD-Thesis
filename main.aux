\@writefile{toe}{\contentsline {epigraphs}{\\Oh! I have slipped the surly bonds of Earth\\And danced the skies on laughter-silvered wings;\\...\\And, while with silent lifting mind I've trod\\The high untrespassed sanctity of space,\\Put out my hand, and touched the face of God.\\(\textit  {High Flight}, by\ John Magee Jr.)}{81}{epigraphs.16}\protected@file@percent }
